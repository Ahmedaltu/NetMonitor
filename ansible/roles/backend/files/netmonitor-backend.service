[Unit]
Description=NetMonitor FastAPI Backend
After=network.target docker.service

[Service]
Type=simple
User={{ ansible_user }}
WorkingDirectory={{ backend_deploy_dir }}
EnvironmentFile={{ backend_deploy_dir }}/.env
ExecStart={{ backend_venv_dir }}/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port {{ backend_port }}
Restart=always

[Install]
WantedBy=multi-user.target
