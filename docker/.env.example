# NetMonitor Docker Compose Environment Variables
# Copy this file to .env and customize as needed

# Agent
AGENT_ID=agent-001
INTERVAL=10
PING_TARGET=8.8.8.8
PING_COUNT=4

# InfluxDB
INFLUX_USER=admin
INFLUX_PASSWORD=netmonitor123
INFLUX_TOKEN=netmonitor-dev-token

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=netmonitor
